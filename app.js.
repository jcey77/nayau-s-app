const SUPABASE_URL = 'https://iprysphevioraubkgqhw.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_geoxJF2u0UMApKZfcbOd_Q_gnYJnpqj';
const OWNER_EMAIL = 'GANTI_DENGAN_EMAIL_OWNER';
const sbReady = window.supabase && SUPABASE_URL.startsWith('https://') && !SUPABASE_URL.includes('PASTE_') && !SUPABASE_ANON_KEY.includes('PASTE_');
const db = sbReady ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;
let session=null, profile=null, products=[], settings={}, payments={}, registerMode=false, stockAction='add';
const $=id=>document.getElementById(id); const money=n=>'Rp '+Number(n||0).toLocaleString('id-ID');
const escapeHTML=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}
function openModal(id){$(id).classList.remove('hidden')} function closeModal(id){$(id).classList.add('hidden')}
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>closeModal(b.dataset.close));
function needConfig(){if(!db){toast('Sambungkan Supabase dulu. Lihat README ya!');return true}return false}
async function refresh(){if(!db){products=JSON.parse(localStorage.getItem('kk_demo_products')||'[]');settings=JSON.parse(localStorage.getItem('kk_demo_settings')||'{}');payments=JSON.parse(localStorage.getItem('kk_demo_payments')||'{}');renderAll();return}
 const [p,s,pay]=await Promise.all([db.from('products').select('*').order('created_at',{ascending:false}),db.from('store_settings').select('*').eq('id',1).maybeSingle(),db.from('payment_settings').select('*').eq('id',1).maybeSingle()]);
 if(p.error)console.error(p.error);products=p.data||[];settings=s.data||{};payments=pay.data||{};renderAll();}
async function loadProfile(){if(!db||!session)return;const {data,error}=await db.from('profiles').select('*').eq('id',session.user.id).maybeSingle();if(error)console.error(error);profile=data||null;updateAuthUI();}
function updateAuthUI(){$('authOpen').classList.toggle('hidden',!!session);$('logoutBtn').classList.toggle('hidden',!session);$('ownerPanel').classList.toggle('hidden',!(profile&&profile.role==='owner'));if(session&&profile){$('authOpen').textContent=profile.display_name||session.user.email;}}
function renderAll(){renderProducts();renderPayments();$('productCount').textContent=products.filter(p=>p.is_visible&&p.stock>0).length;}
function renderProducts(){const q=$('searchInput').value.toLowerCase();const visible=products.filter(p=>p.is_visible&&p.stock>0&&(`${p.name} ${p.note||''}`).toLowerCase().includes(q));$('productGrid').innerHTML=visible.length?visible.map(p=>`<article class="product-card"><div class="product-image">${p.image_url?`<img src="${escapeHTML(p.image_url)}" alt="${escapeHTML(p.name)}" loading="lazy" onerror="this.parentElement.textContent='୨୧'">`:'୨୧'}</div><h3>${escapeHTML(p.name)}</h3><p class="product-note">${escapeHTML(p.note||'Premium service untuk kamu ♡')}</p><div class="product-meta"><span class="price">${money(p.price)}</span><span class="stock">Stok ${p.stock}</span></div><a class="btn btn-dark" href="https://wa.me/${encodeURIComponent((payments.wa_number||'62895324866749').replace(/\D/g,''))}?text=${encodeURIComponent('Halo admin, saya mau order '+p.name)}" target="_blank" rel="noreferrer">Pesan sekarang ↗</a></article>`).join(''):'<div class="empty-state">Belum ada produk yang tersedia. ♡</div>';if(profile?.role==='owner')renderOwnerProducts();}
function renderPayments(){let arr=[];if(payments.enable_ovo)arr.push(`<div class="payment-card"><b>OVO</b><span>${escapeHTML(payments.ovo_number||'Nomor belum diatur')}</span></div>`);if(payments.enable_gopay)arr.push(`<div class="payment-card"><b>GoPay</b><span>${escapeHTML(payments.gopay_number||'Nomor belum diatur')}</span></div>`);if(payments.enable_qris)arr.push(`<div class="payment-card"><b>QRIS</b><span>${escapeHTML(payments.payment_name||'Scan untuk membayar')}</span>${payments.qris_image?`<img src="${escapeHTML(payments.qris_image)}" alt="QRIS">`:''}</div>`);$('paymentList').innerHTML=arr.length?arr.join(''):'<div class="empty-state">Metode pembayaran akan ditampilkan di sini. ♡</div>';}
function renderOwnerProducts(){if(!profile||profile.role!=='owner')return;$('ownerProducts').innerHTML=products.length?products.map(p=>`<div class="owner-row"><div><strong>${escapeHTML(p.name)} ${p.is_visible?'':'· disembunyikan'}</strong><small>${money(p.price)} · stok ${p.stock} · ${escapeHTML(p.note||'Tanpa note')}</small></div><div class="owner-actions"><button class="mini-btn" onclick="editProduct('${p.id}')">Edit</button><button class="mini-btn" onclick="openStock('${p.id}')">Stok ±</button><button class="mini-btn" onclick="toggleVisible('${p.id}',${!p.is_visible})">${p.is_visible?'Sembunyikan':'Tampilkan'}</button><button class="mini-btn danger" onclick="deleteProduct('${p.id}')">Hapus</button></div></div>`).join(''):'<div class="empty-state">Belum ada produk. Tambahkan produk pertamamu!</div>';const threshold=Number(settings.low_stock_threshold??3);const alerts=products.filter(p=>p.stock<=threshold);$('stockAlerts').innerHTML=alerts.length?alerts.map(p=>`<div class="alert-line">♡ ${escapeHTML(p.name)} — stok tersisa ${p.stock}</div>`).join(''):'<span class="hint">Semua stok aman. Tidak ada peringatan saat ini.</span>';}
function fillPaymentForm(){['ovo','gopay','qris'].forEach(k=>$('pay'+k[0].toUpperCase()+k.slice(1)).checked=!!payments['enable_'+k]);$('ovoNumber').value=payments.ovo_number||'';$('gopayNumber').value=payments.gopay_number||'';$('paymentName').value=payments.payment_name||'';$('waNumber').value=payments.wa_number||'62895324866749';$('telegramUser').value=payments.telegram_username||'';$('qrisImage').value=payments.qris_image||'';$('storeName').value=settings.store_name||'kedai kanesyie';$('lowStock').value=settings.low_stock_threshold??3;$('welcomeText').value=settings.welcome_text||'';$('specialFeature').checked=!!settings.special_feature;}
async function saveRow(table,payload){if(!db){toast('Mode demo: perubahan hanya tersimpan di browser ini.');return {error:null}}const {error}=await db.from(table).upsert(payload);if(error)toast(error.message);return {error};}
$('authOpen').onclick=()=>{registerMode=false;setAuthMode();openModal('authModal')};$('switchAuthBtn').onclick=()=>{registerMode=!registerMode;setAuthMode()};function setAuthMode(){$('authTitle').textContent=registerMode?'Daftar akun':'Login';$('authSubmit').textContent=registerMode?'Daftar':'Login';$('switchAuth').firstChild.textContent=registerMode?'Sudah punya akun? ':'Belum punya akun? ';$('switchAuthBtn').textContent=registerMode?'Login':'Daftar';$('authMessage').textContent='';}
$('authForm').onsubmit=async e=>{e.preventDefault();if(needConfig())return;const email=$('authEmail').value.trim(),password=$('authPassword').value;let res;if(registerMode)res=await db.auth.signUp({email,password,options:{data:{display_name:email.split('@')[0]}}});else res=await db.auth.signInWithPassword({email,password});if(res.error){$('authMessage').textContent=res.error.message;return}if(registerMode){$('authMessage').textContent='Akun dibuat. Cek email untuk verifikasi jika diminta, lalu login.';return}session=res.data.session;await loadProfile();await refresh();closeModal('authModal');toast('Login berhasil ♡');};
$('logoutBtn').onclick=async()=>{if(db)await db.auth.signOut();session=null;profile=null;updateAuthUI();$('ownerPanel').classList.add('hidden');toast('Kamu sudah logout');};
$('addProductBtn').onclick=()=>{if(!profile||profile.role!=='owner')return; $('productForm').reset();$('editProductId').value='';$('productModalTitle').textContent='Tambah produk';$('prodVisible').checked=true;openModal('productModal')};
window.editProduct=id=>{const p=products.find(x=>x.id===id);if(!p)return;$('productForm').reset();$('editProductId').value=p.id;$('prodName').value=p.name;$('prodPrice').value=p.price;$('prodStock').value=p.stock;$('prodImage').value=p.image_url||'';$('prodNote').value=p.note||'';$('prodVisible').checked=p.is_visible;$('productModalTitle').textContent='Edit produk';openModal('productModal')};
$('productForm').onsubmit=async e=>{e.preventDefault();if(!profile||profile.role!=='owner')return;const id=$('editProductId').value;const payload={name:$('prodName').value.trim(),price:Number($('prodPrice').value),stock:Number($('prodStock').value),image_url:$('prodImage').value.trim()||null,note:$('prodNote').value.trim(),is_visible:$('prodVisible').checked};if(db){const res=id?await db.from('products').update(payload).eq('id',id):await db.from('products').insert(payload);if(res.error){$('productMessage').textContent=res.error.message;return}}else{if(id)products=products.map(p=>p.id===id?{...p,...payload}:p);else products.unshift({id:crypto.randomUUID(),...payload});localStorage.setItem('kk_demo_products',JSON.stringify(products))}closeModal('productModal');await refresh();toast('Produk berhasil disimpan ♡')};
window.openStock=id=>{$('stockProductId').value=id;$('stockAmount').value=1;$('stockMessage').textContent='';openModal('stockModal')};$('stockForm').onsubmit=async e=>{e.preventDefault();const btn=e.submitter;stockAction=btn?.dataset.stock||'add';const p=products.find(x=>x.id===$('stockProductId').value);if(!p)return;const amount=Number($('stockAmount').value);const next=stockAction==='add'?p.stock+amount:p.stock-amount;if(next<0){$('stockMessage').textContent='Stok tidak boleh kurang dari 0.';return}if(db){const {error}=await db.from('products').update({stock:next}).eq('id',p.id);if(error){$('stockMessage').textContent=error.message;return}}else{p.stock=next;localStorage.setItem('kk_demo_products',JSON.stringify(products))}closeModal('stockModal');await refresh();toast('Stok berhasil diperbarui ♡')};
window.toggleVisible=async(id,value)=>{if(db){const {error}=await db.from('products').update({is_visible:value}).eq('id',id);if(error){toast(error.message);return}}else{const p=products.find(x=>x.id===id);p.is_visible=value;localStorage.setItem('kk_demo_products',JSON.stringify(products))}await refresh();toast('Tampilan produk diperbarui')};
window.deleteProduct=async id=>{if(!confirm('Yakin ingin menghapus produk ini?'))return;if(db){const {error}=await db.from('products').delete().eq('id',id);if(error){toast(error.message);return}}else{products=products.filter(p=>p.id!==id);localStorage.setItem('kk_demo_products',JSON.stringify(products))}await refresh();toast('Produk dihapus')};
$('savePaymentBtn').onclick=async()=>{if(!profile||profile.role!=='owner')return;const payload={id:1,enable_ovo:$('payOvo').checked,enable_gopay:$('payGopay').checked,enable_qris:$('payQris').checked,ovo_number:$('ovoNumber').value.trim(),gopay_number:$('gopayNumber').value.trim(),payment_name:$('paymentName').value.trim(),wa_number:$('waNumber').value.trim(),telegram_username:$('telegramUser').value.trim(),qris_image:$('qrisImage').value.trim()};if(db){const {error}=await db.from('payment_settings').upsert(payload);if(error){toast(error.message);return}}payments=payload;localStorage.setItem('kk_demo_payments',JSON.stringify(payments));renderPayments();toast('Pengaturan payment tersimpan ♡')};
$('saveSettingsBtn').onclick=async()=>{if(!profile||profile.role!=='owner')return;const payload={id:1,store_name:$('storeName').value.trim(),low_stock_threshold:Number($('lowStock').value),welcome_text:$('welcomeText').value.trim(),special_feature:$('specialFeature').checked};if(db){const {error}=await db.from('store_settings').upsert(payload);if(error){toast(error.message);return}}settings=payload;localStorage.setItem('kk_demo_settings',JSON.stringify(settings));toast('Pengaturan toko tersimpan ♡')};
async function loadMembers(){if(!db||profile?.role!=='owner')return;const {data,error}=await db.from('profiles').select('id,email,display_name,role,created_at').order('created_at',{ascending:false});if(error){$('memberList').textContent=error.message;return}$('memberList').innerHTML=(data||[]).map(m=>`<div class="owner-row"><div><strong>${escapeHTML(m.display_name||m.email||'Member')}</strong><small>${escapeHTML(m.email||'')} · ${escapeHTML(m.role)}</small></div><select aria-label="Role member" onchange="changeRole('${m.id}',this.value)"><option value="member" ${m.role==='member'?'selected':''}>member</option><option value="silucu" ${m.role==='silucu'?'selected':''}>silucu</option><option value="sigemoi" ${m.role==='sigemoi'?'selected':''}>sigemoi</option><option value="sikecil" ${m.role==='sikecil'?'selected':''}>sikecil</option><option value="admin" ${m.role==='admin'?'selected':''}>admin</option></select></div>`).join('')||'<div class="empty-state">Belum ada member.</div>'}
window.changeRole=async(id,role)=>{if(!['member','silucu','sigemoi','sikecil','admin'].includes(role))return;const {error}=await db.from('profiles').update({role}).eq('id',id);if(error){toast(error.message);return}toast('Role member diperbarui');loadMembers()};
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.tab-panel').forEach(x=>x.classList.toggle('hidden',x.id!==b.dataset.tab));if(b.dataset.tab==='paymentsTab')fillPaymentForm();if(b.dataset.tab==='settingsTab')fillPaymentForm();if(b.dataset.tab==='membersTab')loadMembers()});$('searchInput').oninput=renderProducts;
$('year').textContent=new Date().getFullYear();
(async()=>{if(db){const {data}=await db.auth.getSession();session=data.session;await loadProfile();db.auth.onAuthStateChange(async(_event,s)=>{session=s;await loadProfile();await refresh()})}updateAuthUI();await refresh();if(profile?.role==='owner')renderOwnerProducts()})();
